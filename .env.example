# Copier ce fichier en .env.local puis renseigner les valeurs.

# Supabase — Project Settings > API Keys (fenêtre « Connect » du tableau de bord)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Ancienne clé « anon » acceptée à la place de la clé publishable :
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL publique du site (balises de partage, sitemap). Par défaut : https://comora.fr
# NEXT_PUBLIC_SITE_URL=https://comora.fr
