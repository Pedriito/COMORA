# Copier ce fichier en .env.local puis renseigner les valeurs.
# Aucune valeur réelle ne doit être commitée : ce dépôt est public.

# ── Supabase ─────────────────────────────────────────────────────────────
# Project Settings > API Keys (fenêtre « Connect » du tableau de bord).
# Projet Comora uniquement, région UE (Paris, eu-west-3).
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Ancienne clé « anon » acceptée à la place de la clé publishable :
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé secrète (serveur uniquement, JAMAIS de préfixe NEXT_PUBLIC_) : contourne la RLS
SUPABASE_SECRET_KEY=sb_secret_...
# Ancienne clé « service_role » acceptée à la place :
# SUPABASE_SERVICE_ROLE_KEY=

# ── Site ─────────────────────────────────────────────────────────────────
# URL publique (balises de partage, sitemap, liens des e-mails et des invitations).
# Par défaut : https://comora.fr
# NEXT_PUBLIC_SITE_URL=https://comora.fr

# Page /admin (demandes d'accès) — mot de passe (12 caractères minimum) et
# secret de signature des sessions (32 caractères minimum : openssl rand -base64 48)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ── E-mails (Resend) ─────────────────────────────────────────────────────
RESEND_API_KEY=re_...
# Expéditeur (domaine vérifié dans Resend). En test, sans domaine vérifié :
# Comora <onboarding@resend.dev>
RESEND_FROM=Comora <bonjour@comora.fr>
# Adresse de réponse (facultatif)
# RESEND_REPLY_TO=

# ── Notifications push (VAPID) ───────────────────────────────────────────
# Clés propres à Comora : npx web-push generate-vapid-keys
# La clé publique est envoyée aux navigateurs ; la clé privée reste sur le serveur.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact transmis aux services de push (mailto: ou https:)
VAPID_SUBJECT=mailto:bonjour@comora.fr

# ── Tâches planifiées (Vercel Cron) ──────────────────────────────────────
# Secret envoyé par Vercel dans « Authorization: Bearer … » (openssl rand -hex 32)
CRON_SECRET=

# ── Offre fondateurs ─────────────────────────────────────────────────────
# Les églises inscrites avant cette date sont marquées « fondatrices » (étape 3).
FOUNDER_DEADLINE=2027-01-20T23:59:59+01:00

# ── Médiathèque ──────────────────────────────────────────────────────────
# Recherche de photos Unsplash (facultatif) : https://unsplash.com/developers
# UNSPLASH_ACCESS_KEY=

# ── Domaines ─────────────────────────────────────────────────────────────
# Domaine racine : espace sur app.<domaine>, sites d'église sur <slug>.<domaine>.
# En local : app.localhost:3000 et <slug>.localhost:3000.
# NEXT_PUBLIC_ROOT_DOMAIN=comora.fr

# ── Liens signés ─────────────────────────────────────────────────────────
# Secret de signature des liens envoyés par e-mail (réponse à une affectation).
# 32 caractères minimum : openssl rand -base64 48
APP_TOKEN_SECRET=
