# Copier ce fichier en .env.local puis renseigner les valeurs.

# Supabase — Project Settings > API Keys (fenêtre « Connect » du tableau de bord)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Ancienne clé « anon » acceptée à la place de la clé publishable :
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé secrète (serveur uniquement, JAMAIS de préfixe NEXT_PUBLIC_) : page /admin et création des comptes
SUPABASE_SECRET_KEY=sb_secret_...
# Ancienne clé « service_role » acceptée à la place :
# SUPABASE_SERVICE_ROLE_KEY=

# Page /admin — mot de passe (12 caractères minimum) et secret de signature des sessions (32 caractères minimum)
# Générer un secret : openssl rand -base64 48
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Resend — e-mails d'acceptation et de refus (domaine d'envoi à vérifier dans Resend)
RESEND_API_KEY=re_...
# En test, sans domaine vérifié : Comora <onboarding@resend.dev>
RESEND_FROM=Comora <bonjour@comora.fr>
# Adresse de réponse (facultatif)
# RESEND_REPLY_TO=

# URL publique du site (balises de partage, sitemap, liens des e-mails). Par défaut : https://comora.fr
# NEXT_PUBLIC_SITE_URL=https://comora.fr
